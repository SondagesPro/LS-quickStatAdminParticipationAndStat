{% if aStatPanel.userName %}
<li class="nav-item dropdown dropdown">
    <a class="nav-link dropdown-toggle" role="button" href="#" data-bs-toggle="dropdown" aria-expanded="false" data-navtargetid="qsapas-user-dropdown" >
        {{ aStatPanel.userName }}
    </a>
    <ul id="qsapas-user-dropdown" class="dropdown-menu dropdown-menu-end">
        {% if aSurveyInfo.class.body == 'fruity_twentythree' %}
        <li class="index-item">
            <a class="back-link nav-link" href="#">{{ gT("Previous") }}</a>
        </li>
        {% endif %}
        {% if aStatPanel.showAdmin %}
            <li>
                <a class="dropdown-item" href="{{ createUrl('surveyAdministration/view',{'surveyid': aSurveyInfo.sid}) }}">
                {{ gT('Administration') }}
                </a>
            </li>
        {% endif %}
        <li>
            <a class="dropdown-item" href="{{ createUrl('/admin/authentication',{'sa': 'logout'}) }}">
            {{ gT('Logout') }}
            </a>
        </li>
    </ul>
</li>
{% endif %}
